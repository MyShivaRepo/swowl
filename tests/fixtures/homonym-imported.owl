<?xml version="1.0"?>
<!-- Ontologie importée par homonym-main.owl (issue #20). -->
<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xml:base="http://example.org/hom-imported">
  <owl:Ontology rdf:about="http://example.org/hom-imported"/>
  <owl:ObjectProperty rdf:ID="definedBy"/>
  <owl:Class rdf:ID="Spec"/>
</rdf:RDF>
