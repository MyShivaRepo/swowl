# SWOWL — configuration locale Docker.
# Copiez ce fichier en `.env` et adaptez à votre machine :
#     cp .env.example .env
# (`.env` est ignoré par git — il est propre à chaque poste.)

# Chemin hôte ABSOLU de votre répertoire home. Il est monté en lecture/écriture dans
# le conteneur et sert de point de départ à la navigation filesystem.
#   macOS  : /Users/votre-user
#   Linux  : /home/votre-user
HOST_HOME=/Users/your-user

# UID / GID de votre utilisateur hôte, pour que le backend écrive des fichiers qui
# VOUS appartiennent (et non root). Trouvez-les avec :  id -u   et   id -g
UID=1000
GID=1000
